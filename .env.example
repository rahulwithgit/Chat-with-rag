# Copy to .env and adjust if needed.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:0.5b
# Keep model loaded in memory between CLI runs (Ollama). Use 0 to unload after each request.
OLLAMA_KEEP_ALIVE=30m
# Cap generated tokens (lower = faster replies, shorter answers).
OLLAMA_NUM_PREDICT=256
# Context window size (tokens). Raise if Ollama errors on long prompts.
OLLAMA_NUM_CTX=2048
OLLAMA_TEMPERATURE=0.2
CHROMA_PATH=.chroma
COLLECTION_NAME=mini_rag_docs
CHUNK_SIZE=400
CHUNK_OVERLAP=80
TOP_K=4
# Hard cap on retrieved context length (characters) before calling the model.
MAX_CONTEXT_CHARS=2000
